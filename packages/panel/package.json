{
  "name": "@zakobot/panel",
  "version": "0.1.0",
  "description": "ZakoBot web management panel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mooooooon/zako-bot.git",
    "directory": "packages/panel"
  },
  "type": "module",
  "main": "./dist/server/index.js",
  "files": ["dist"],
  "scripts": {
    "dev": "concurrently \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@zakobot/shared": "workspace:*",
    "@zakobot/database": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vue-tsc": "^2.2.0"
  }
}
