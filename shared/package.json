{
  "name": "@zakobot/shared",
  "version": "0.2.0",
  "description": "ZakoBot shared TypeScript types",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mooooooon/zako-bot.git",
    "directory": "shared"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./panel-auth": {
      "import": "./dist/panel-auth.js",
      "types": "./dist/panel-auth.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3"
  }
}
